# AgentLine — open-source configuration
# Copy this file to .env and fill in the providers you actually use.
# You pay those providers directly. There is no hosted balance and no Supabase.

# ── Database ─────────────────────────────────────────────────
# Docker Compose default:
DATABASE_URL=postgresql://agentline:secret@localhost:5432/agentline

# ── Redis (optional) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Telephony provider ───────────────────────────────────────
# signalwire | twilio | plivo | telnyx | your_package.module:YourProvider
TELEPHONY_PROVIDER=signalwire

# SignalWire — https://signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE_URL=

# Twilio — https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Plivo — https://www.plivo.com
# Create an application whose answer URL is {BASE_URL}/plivo/inbound
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_APP_ID=

# Telnyx TeXML — https://telnyx.com
# TELNYX_ACCOUNT_SID is the TeXML application id.
# TELNYX_CONNECTION_ID attaches purchased numbers to that application.
# Set the application voice URL to {BASE_URL}/telnyx/inbound
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_CONNECTION_ID=

# ── Voice runtime ────────────────────────────────────────────
# builtin | livekit | pipecat | your_package.module:YourRuntime
# An agent can override this with voice_runtime on POST /v1/agents.
VOICE_RUNTIME=builtin

# Built-in pipeline hooks (used when VOICE_RUNTIME=builtin)
# deepgram | your_package.module:YourSTT
STT_PROVIDER=deepgram
# cartesia | your_package.module:YourTTS
TTS_PROVIDER=cartesia
# openai | your_package.module:YourLLM
LLM_PROVIDER=openai

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible server.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional fast model for semantic end-of-turn detection. Empty uses the default chat model.
TURN_TAKING_MODEL=

# LiveKit — pip install -r requirements-livekit.txt
# LIVEKIT_SIP_URI may include {room} {call_id} {from_number} {to_number}
# Example: sip:{room}@your-project.sip.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=agentline
LIVEKIT_SIP_URI=

# Pipecat — pip install -r requirements-pipecat.txt
# Optional replacement for the default bot: package.module:function
PIPECAT_FACTORY=

# ── App ──────────────────────────────────────────────────────
SECRET_KEY=generate-a-random-string-here
BASE_URL=http://localhost:8000
WEBHOOK_SECRET_SALT=generate-a-random-string-here
